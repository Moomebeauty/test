    return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0"); });
  const results=await Promise.all(yms.map(fetchMonthData));
  if(my!==fastSeq) return;                                   // 期間又重抓了，用新的那次
  if(results.every(r=>!r)){ $("fastCard").style.display="none"; return; }   // 全部失敗就先不顯示
  // 整理出「明天以後、有空檔」的每一天
  const days=[];
  results.forEach(r=>{ if(!r) return;
    Object.keys(r.data).forEach(ds=>{
      const dObj=new Date(ds+"T00:00:00");
      if(isNaN(dObj) || dObj<=today) return;
      if(r.stat && r.stat[ds]) return;                         // 休假／進修
      const sl=(r.data[ds]||[]).filter(t=>ALL_TIMES.indexOf(t)>=0).sort();
      if(sl.length) days.push({ ds, dObj, slots:sl });
    });
  });
  days.sort((a,b)=> a.ds<b.ds ? -1 : 1);
  const isOff = x => x.dObj.getDay()===0 || x.dObj.getDay()===6 || !!HOLIDAYS[x.ds];
  const holis = days.filter(isOff).slice(0,3);

  const body=$("fastBody"); body.innerHTML="";
  const addHead = txt => { const h=document.createElement("div"); h.className="fast-h"; h.textContent=txt; body.appendChild(h); };
  const addNone = txt => { const n=document.createElement("div"); n.className="fast-none"; n.textContent=txt; body.appendChild(n); };
  function addRow(x){
    const row=document.createElement("div"); row.className="fast-row";
    const lab=document.createElement("div"); lab.className="fast-date";
    lab.textContent=`${x.dObj.getMonth()+1}/${x.dObj.getDate()}（${WEEK[x.dObj.getDay()]}）`;
    if(HOLIDAYS[x.ds]){ const h=document.createElement("span"); h.className="fast-hol"; h.textContent=HOLIDAYS[x.ds]; lab.appendChild(h); }
    lab.onclick=()=>{ st.date=x.ds; st.time=null; tapDate(x.ds, x.slots); };
    row.appendChild(lab);
    x.slots.slice(0,3).forEach(t=>{
      const c=document.createElement("button"); c.className="fast-chip"; c.textContent=t;
      c.onclick=()=>{ st.date=x.ds; st.time=null; tapDate(x.ds, x.slots, t); };   // 點了直接幫你選好這個時段
      row.appendChild(c);
    });
    if(x.slots.length>3){
      const m=document.createElement("button"); m.className="fast-more"; m.textContent=`+${x.slots.length-3}`; m.title="看全部時段";
      m.onclick=()=>{ st.date=x.ds; st.time=null; tapDate(x.ds, x.slots); };
      row.appendChild(m);
    }
    body.appendChild(row);
  }
  addHead("⚡ 最快可預約");
  if(days.length) addRow(days[0]); else addNone("近 3 個月的時段都滿了，歡迎私訊老師詢問 ♡");
  const sep=document.createElement("div"); sep.className="fast-sep"; body.appendChild(sep);
  addHead("🌿 最近的假日空檔");
  if(holis.length) holis.forEach(addRow); else addNone("近期假日都滿了，平日還有機會喔 ♡");

  // 月曆停在「這個月已經完全沒空檔」的月份時（例如月底），自動跳到最快有空的那個月
  if(days.length && viewYM && !calTouched){
    const f=days[0].dObj;
    const viewIdx=viewYM.y*12+viewYM.m, firstIdx=f.getFullYear()*12+f.getMonth();
    const curYm=ymStr();
    if(viewIdx<firstIdx && !days.some(x=>x.ds.startsWith(curYm))){
      viewYM={y:f.getFullYear(), m:f.getMonth()};
      loadMonth();
    }
  }
}

/* 點某一天 → 先切頁 + 顯示讀取中 → 快速向後端拿「這一天」最新時段 → 再進時段頁
   避免拿到月快取導致剛被約走還顯示可約。4 秒拿不到就用快取退回
   pre：從「最快可預約」點進來的話，順便幫客人選好那個時段 */
function tapDate(ds, cachedSlots, pre){
  show(1);
  const d=new Date(ds+"T00:00:00");
  const wd=["日","一","二","三","四","五","六"][d.getDay()];
  $("dayTitle").innerHTML = `<span class="dnum">${d.getMonth()+1}月${d.getDate()}日</span><span class="dwk">星期${wd}</span>`;
  $("availCard").style.display="block"; $("fullNote").style.display="none"; $("fullWrap").style.display="none";
  $("availLabel").textContent="可預約時段";
  $("timesAvail").innerHTML=`<div class="loading" style="grid-column:1/-1;padding:14px">⚡ 確認最新時段中…</div>`;
  $("timesFull").innerHTML="";
  const cb="freshDay_"+Date.now();
  const timer=setTimeout(()=>{ cleanup(); openDay(ds, cachedSlots, pre); },4000);
  function cleanup(){ delete window[cb]; const el=document.getElementById(cb); if(el)el.remove(); clearTimeout(timer); }
  window[cb]=function(res){ cleanup();
    let fresh=cachedSlots;
    if(res && Array.isArray(res.slots)){
      fresh=res.slots.filter(t=>/^\d{2}:\d{2}$/.test(t) && ALL_TIMES.indexOf(t)>=0);
      monthData[ds]=fresh;   // 順便更新本月快取
    }
    openDay(ds, fresh, pre);
  };
  const s=document.createElement("script"); s.id=cb;
  s.src=SCRIPT_URL+"?action=getSlots&date="+encodeURIComponent(ds)+"&_t="+Date.now()+"&callback="+cb;
  s.onerror=()=>{ cleanup(); openDay(ds, cachedSlots, pre); };
  document.body.appendChild(s);
}

/* 選某天 → 進時段頁 */
function openDay(ds, slots, pre){
  const d=new Date(ds+"T00:00:00");
  const wd=["日","一","二","三","四","五","六"][d.getDay()];
  $("dayTitle").innerHTML = `<span class="dnum">${d.getMonth()+1}月${d.getDate()}日</span><span class="dwk">星期${wd}</span>`;
  const avail=$("timesAvail"); avail.innerHTML="";
  const full=$("timesFull"); full.innerHTML="";
  const openSlots = ALL_TIMES.filter(t=>slots.indexOf(t)>=0);
  const fullSlots = ALL_TIMES.filter(t=>slots.indexOf(t)<0);

  // 可預約（放最上面，醒目綠卡）
  if(openSlots.length===0){
    $("availCard").style.display="none";
    $("fullNote").style.display="block";
  }else{
    $("availCard").style.display="block";
    $("fullNote").style.display="none";
    // 剩 3 個以內，右邊加「僅剩 N 個」紅色小標籤
    $("availLabel").innerHTML = "可預約時段" + (openSlots.length<=3 ? `<span class="few-badge">僅剩 ${openSlots.length} 個</span>` : "");
    avail.style.display="grid";
    openSlots.forEach(t=>{
      const b=document.createElement("div"); b.className="slot"; b.textContent=t;
      b.onclick=()=>{ st.time=t; [...avail.children].forEach(x=>x.classList.remove("sel")); b.classList.add("sel"); $("p1next").disabled=false; };
      avail.appendChild(b);
    });
  }

  // 時段已額滿：只列「整點」，用淡色小標籤（半點照樣可以預約，只是這裡不列出來）
  const fullHours = fullSlots.filter(t=>t.endsWith(":00"));
  if(fullHours.length===0){
    $("fullWrap").style.display="none";
  }else{
    $("fullWrap").style.display="block";
    fullHours.forEach(t=>{
      const c=document.createElement("span"); c.className="full-chip"; c.textContent=t;
      full.appendChild(c);
    });
  }
  $("p1next").disabled=true;
  // 從「最快可預約」點進來的：如果那個時段還在，直接幫客人選好
  if(pre && openSlots.indexOf(pre)>=0){
    const el=[...avail.children].find(x=>x.textContent===pre);
    if(el){ el.classList.add("sel"); st.time=pre; $("p1next").disabled=false; }
  }
  show(1);
}
