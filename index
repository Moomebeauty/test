  .resch-bar .rb-txt{flex:1}
  .resch-bar button{font:inherit;font-size:12.5px;padding:6px 12px;border-radius:16px;border:1px solid var(--brand);
    background:#fff;color:var(--brand-deep);cursor:pointer;white-space:nowrap}

  /* ===== 老師模式按鈕（只有老師本人會看到）===== */
  .adm-entry{position:absolute;right:52px;top:50%;transform:translateY(-45%);
    background:#fff;border:1px solid var(--brand);color:var(--brand-deep);
    width:34px;height:34px;border-radius:50%;cursor:pointer;font-size:15px;
    display:none;align-items:center;justify-content:center;padding:0;line-height:1}
  .adm-entry.show{display:flex}
  .adm-entry:active{background:var(--brand-soft)}

  /* ===== 老師模式面板 ===== */
  .adm-panel{display:none;position:relative;z-index:1;padding:0 22px 44px;background:var(--ivory)}
  .adm-panel.show{display:block}
  .adm-topbar{display:flex;align-items:center;justify-content:space-between;
    padding:18px 0 10px;border-bottom:1px solid var(--divider);margin-bottom:4px}
  .adm-title{font-family:"Noto Serif TC",serif;font-size:17px;font-weight:700;color:var(--ink)}
  .adm-back{font:inherit;font-size:13px;padding:8px 14px;border:1px solid var(--brand);
    border-radius:20px;background:#fff;color:var(--brand-deep);cursor:pointer;font-weight:600}
  .adm-section{padding:22px 0;border-bottom:1px solid var(--divider)}
  .adm-section:last-child{border-bottom:none}
  .adm-section.batch{background:transparent}
  .adm-tag2{font-family:"Noto Serif TC",serif;font-size:16px;font-weight:700;color:var(--ink);margin-bottom:10px}
  .adm-tip{font-size:12.5px;color:var(--muted);margin:8px 0 14px;line-height:1.75}
  .adm-rangebar{display:flex;gap:12px;margin:12px 0 4px}
  .adm-rangebar .rb{flex:1}
  .adm-lbl{display:block;font-size:13px;color:var(--muted);margin-bottom:8px}
  .adm-panel input[type=date]{width:100%;font:inherit;padding:14px 15px;border:1px solid var(--line);
    border-radius:14px;background:var(--cream-soft);color:var(--ink)}
  .adm-panel input[type=date]:focus{outline:none;border-color:var(--taupe)}
  .adm-daytab{display:flex;gap:10px;margin:14px 0 14px}
  .adm-dtab{flex:1;font:inherit;font-size:14px;font-weight:600;padding:12px;
    border:1.5px solid var(--line);border-radius:12px;background:var(--cream-soft);
    color:var(--muted);cursor:pointer;transition:.18s}
