    <button class="refreshbtn" id="retryCal" style="margin-top:12px">↻ 再試一次</button>
  </div>`;
  const b=$("retryCal"); if(b) b.onclick=()=>{ for(const k in monthCache) delete monthCache[k]; loadMonth(); };
}

/* 背景預抓某月資料存進快取（不影響畫面）*/
function prefetchMonth(y,m){
  const d=new Date(y,m,1);
  const ym=d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0");
  const c=monthCache[ym];
  if(c && (Date.now()-c.at < CACHE_TTL))return; // 還新鮮就不重抓
  const cb="preCB_"+Date.now();
  function cleanup(){ delete window[cb]; const s=document.getElementById(cb); if(s)s.remove(); }
  const timer=setTimeout(cleanup,7000);
  window[cb]=function(res){ clearTimeout(timer); cleanup();
    if(res && typeof res.month==="object" && res.month!==null){
      monthCache[ym]={data:res.month, stat:res.status||{}, at:Date.now()};
    } };
  const s=document.createElement("script"); s.id=cb;
  s.src=SCRIPT_URL+"?action=getMonth&ym="+encodeURIComponent(ym)+"&callback="+cb;
  s.onerror=()=>{ clearTimeout(timer); cleanup(); };
  document.body.appendChild(s);
}

function renderCal(){
  const grid=$("calGrid"); grid.innerHTML="";
  const first=new Date(viewYM.y,viewYM.m,1);
  // 週一為第一欄：週日(0)要排到第7格，所以位移 (getDay()+6)%7
  const startDay=(first.getDay()+6)%7;
  const daysInMonth=new Date(viewYM.y,viewYM.m+1,0).getDate();
  for(let i=0;i<startDay;i++){ const c=document.createElement("div"); c.className="cell empty"; grid.appendChild(c); }
  for(let d=1;d<=daysInMonth;d++){
    const dateObj=new Date(viewYM.y,viewYM.m,d);
    const ds=fmtDate(dateObj);
    const c=document.createElement("div");
    const rawSlots=monthData[ds]||[];
    const slots=rawSlots.filter(t=>ALL_TIMES.indexOf(t)>=0); // 只算客人實際可點的時段
    const isPast = dateObj <= today;   // 今天（含）以前都不可預約，最早只能約明天
    const holiday = HOLIDAYS[ds]; // 國定假日名稱（若有）
    const dayStat = monthStatus[ds] || "";   // 休假／進修
    const openedThatDay = (ds in monthData);
    const noSlotLeft = openedThatDay && slots.length===0;
    if(dayStat){
      // 老師標示的日程（休假／進修）
      c.className="cell rest"; c.innerHTML=`${d}<span class="tagrest">${dayStat}</span>`;
    }else if(isPast || !openedThatDay || noSlotLeft){
      // 沒有空檔可約（約滿、沒開放、今天以前）→ 一律顯示「已滿」，不可點
      c.className="cell full"; c.innerHTML=`${d}<span class="tagfull">已滿</span>`;
    }else{
      c.className="cell open"; c.innerHTML=`${d}<span class="tagfree">可約</span>`;
      c.onclick=()=>{ st.date=ds; st.time=null; tapDate(ds, slots); };
    }
    if(holiday){ c.classList.add("holiday"); c.title=holiday;
      const tag=document.createElement("span"); tag.className="holi-tag"; tag.textContent=holiday;
      c.appendChild(tag); }
    grid.appendChild(c);
  }
}

