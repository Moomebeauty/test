  .svc.vip .mt{color:#96793f;font-size:12px}
  .svc.vip .vip-pr{color:#7a5f2c;font-weight:700;font-size:13px;white-space:nowrap}
  .svc.addon.sel{background:#f0e6d6}
  .svc-total{display:none;text-align:center;font-size:14px;color:var(--taupe-deep);font-weight:600;
    background:#ece1d0;border-radius:12px;padding:12px;margin-top:6px}

  label.lbl{display:block;font-size:13px;color:var(--muted);margin:14px 4px 7px}
  input[type=text],input[type=tel],textarea{width:100%;font:inherit;padding:14px 15px;border:1px solid var(--line);border-radius:14px;background:var(--cream-soft);color:var(--ink)}
  textarea{resize:vertical;line-height:1.6;min-height:84px}
