/* ===== 老師模式：整段邏輯放在 IIFE，避免跟客人預約頁的變數撞名 ===== */
(function(){
  const OPEN=SHOP.openHour, CLOSE=SHOP.closeHour, STEP=SHOP.slotStep;
  const ALL_SLOTS=[];
  for(let total=OPEN*60; total<=CLOSE*60; total+=STEP){
    const h=Math.floor(total/60), m=total%60;
    ALL_SLOTS.push(`${String(h).padStart(2,"0")}:${String(m).padStart(2,"0")}`);
  }
  let selected=new Set();
  let dayStatus="";

  // 單日設定：建立時段按鈕
  const elSlots=$("admSlots");
  ALL_SLOTS.forEach(t=>{
    const b=document.createElement("div");
    b.className="adm-slot"; b.textContent=t; b.dataset.t=t;
    b.onclick=()=>{ if(selected.has(t))selected.delete(t); else selected.add(t); refresh(); };
    elSlots.appendChild(b);
  });
  function refresh(){
    [...elSlots.children].forEach(c=>c.classList.toggle("on", selected.has(c.dataset.t)));
    $("admCount").textContent = $("admDate").value ? `已選 ${selected.size} 個時段` : "請先選日期";
    $("admSave").disabled = !$("admDate").value;
  }

  // 快速按鈕（單日）
  $("admQAll").onclick=()=>{ selected=new Set(ALL_SLOTS); refresh(); };
  $("admQHour").onclick=()=>{ selected=new Set(ALL_SLOTS.filter(t=>t.endsWith(":00"))); refresh(); };
  $("admQNone").onclick=()=>{ selected.clear(); refresh(); };
  $("admQAM").onclick=()=>{ selected=new Set(ALL_SLOTS.filter(t=>parseInt(t)<12)); refresh(); };
  $("admQPM").onclick=()=>{ selected=new Set(ALL_SLOTS.filter(t=>parseInt(t)>=12)); refresh(); };

  // 檢查後端版本
  $("admVerChk").onclick=()=>{
    $("admVerMsg").className="adm-msg"; $("admVerMsg").textContent="檢查中…";
    const cb="verCB_"+Date.now();
    const t=setTimeout(()=>{ cleanupV(); $("admVerMsg").className="adm-msg err"; $("admVerMsg").textContent="檢查逾時，請確認網路。"; },10000);
    function cleanupV(){ delete window[cb]; const el=document.getElementById(cb); if(el)el.remove(); clearTimeout(t); }
    window[cb]=function(res){ cleanupV();
      if(res && res.version==="tpl-v1"){
        $("admVerMsg").className="adm-msg ok"; $("admVerMsg").textContent="✓ 後端已是最新版（含防撞單、LINE 異常通知）";
      }else{
        $("admVerMsg").className="adm-msg err";
        $("admVerMsg").textContent="✗ 後端仍是舊版 → 請到 Apps Script：部署 → 管理部署作業 → 鉛筆 → 版本選「新版本」→ 部署";
      }
    };
    const sc=document.createElement("script"); sc.id=cb;
    sc.src=SCRIPT_URL+"?action=version&callback="+cb;
    sc.onerror=()=>{ cleanupV(); $("admVerMsg").className="adm-msg err"; $("admVerMsg").textContent="連線失敗。"; };
    document.body.appendChild(sc);
  };

  // 日狀態（休假／進修）
  document.querySelectorAll("#admDayStat .adm-dsbtn").forEach(function(b){
    b.onclick=function(){
      document.querySelectorAll("#admDayStat .adm-dsbtn").forEach(x=>x.classList.remove("on"));
      b.classList.add("on");
      dayStatus = b.getAttribute("data-s") || "";
      if(dayStatus){ selected.clear(); refresh(); }
    };
  });
  function setStatusUI(v){
    dayStatus = v || "";
    document.querySelectorAll("#admDayStat .adm-dsbtn").forEach(x=>{
      x.classList.toggle("on", (x.getAttribute("data-s")||"") === dayStatus);
    });
  }

  // 選日期 → 讀這天已設定的時段
  const elDate=$("admDate");
  const today=new Date(); today.setHours(0,0,0,0);
  elDate.min=today.toISOString().split("T")[0];
  elDate.onchange=()=>{
    $("admMsg").textContent=""; selected.clear(); setStatusUI(""); refresh();
    if(!elDate.value)return;
    const holi=HOLIDAYS[elDate.value];
    const wd=["日","一","二","三","四","五","六"][new Date(elDate.value+"T00:00:00").getDay()];
    const banner=$("admHoliBanner");
    if(holi){ banner.style.display="block"; banner.textContent="🎌 "+elDate.value+"（週"+wd+"）是 "+holi+" — 國定假日"; }
    else { banner.style.display="none"; }
    $("admCount").textContent="讀取中…";
    const cb="admCB_"+Date.now();
    const timer=setTimeout(()=>{ cleanup(); refresh(); },6000);
    function cleanup(){ delete window[cb]; const s=document.getElementById(cb); if(s)s.remove(); clearTimeout(timer); }
    window[cb]=function(res){ cleanup();
      if(res&&res.slots){
        res.slots.filter(t=>/^\d{2}:\d{2}$/.test(t) && ALL_SLOTS.indexOf(t)>=0)
                 .forEach(t=>selected.add(t));
      }
      setStatusUI(res && res.status);
      refresh();
    };
    const s=document.createElement("script"); s.id=cb;
    s.src=SCRIPT_URL+"?action=getSlots&date="+encodeURIComponent(elDate.value)+"&callback="+cb;
    s.onerror=()=>{ cleanup(); refresh(); };
    document.body.appendChild(s);
  };

  // 儲存（單日）— 送出時夾帶 userId，後端會驗證是不是老師本人
  $("admSave").onclick=()=>{
    const btn=$("admSave"); btn.disabled=true; btn.textContent="儲存中…";
    $("admMsg").textContent=""; $("admMsg").className="adm-msg";
    const slots=[...selected].filter(t=>ALL_SLOTS.indexOf(t)>=0).sort();
    const cb="saveCB_"+Date.now();
    const timer=setTimeout(()=>{ cleanup();
      $("admMsg").className="adm-msg err"; $("admMsg").textContent="儲存逾時，請檢查網路後再試一次。";
      btn.disabled=false; btn.textContent="儲存這天的開放時段"; },12000);
    function cleanup(){ delete window[cb]; const el=document.getElementById(cb); if(el)el.remove(); clearTimeout(timer); }
    window[cb]=function(res){ cleanup();
      btn.disabled=false; btn.textContent="儲存這天的開放時段";
      if(res && res.ok){
        selected=new Set((res.saved||[]).filter(t=>ALL_SLOTS.indexOf(t)>=0)); refresh();
        $("admMsg").className="adm-msg ok";
        $("admMsg").textContent = dayStatus
          ? "✓ 已儲存：這天標示為「"+dayStatus+"」，客人月曆會顯示"
          : ((res.saved&&res.saved.length)
              ? "✓ 已儲存："+res.saved.join("、")
              : "✓ 已儲存：這天全部關閉（客人看不到任何時段）");
        // 更新完時段，清除客人預約頁的月份快取
        for(const k in monthCache) delete monthCache[k];
      }else if(res && res.error === "forbidden"){
        $("admMsg").className="adm-msg err";
        $("admMsg").textContent="⚠️ 沒有權限：請確認你是從 LINE 的圖文選單進來的（直接貼網址開啟不會抓到身分）";
      }else{
        const why = (res && res.error) ? ("（後端訊息："+res.error+"）") : "（後端沒有回應此功能，多半是 Apps Script 還沒重新部署）";
        $("admMsg").className="adm-msg err"; $("admMsg").textContent="儲存失敗 "+why;
      }
    };
    const sc=document.createElement("script"); sc.id=cb;
    sc.src=SCRIPT_URL+"?action=saveSlots&date="+encodeURIComponent(elDate.value)
         +"&slots="+encodeURIComponent(slots.join(","))
         +"&status="+encodeURIComponent(dayStatus)
         +"&userId="+encodeURIComponent(st.userId||"")
         +"&callback="+cb;
    sc.onerror=()=>{ cleanup(); $("admMsg").className="adm-msg err"; $("admMsg").textContent="連線失敗，請檢查網路。";
      btn.disabled=false; btn.textContent="儲存這天的開放時段"; };
    document.body.appendChild(sc);
  };

  // 批次設定
  let bSelected = new Set(ALL_SLOTS);
  let bMode = "weekday";
  const bslots = $("admBslots");
  ALL_SLOTS.forEach(t=>{
    const el=document.createElement("div"); el.className="adm-slot on"; el.textContent=t;
    el.onclick=()=>{ if(bSelected.has(t))bSelected.delete(t); else bSelected.add(t); bRefresh(); };
    bslots.appendChild(el);
  });
  function bRefresh(){
    [...bslots.children].forEach(el=>{
      if(bSelected.has(el.textContent)) el.classList.add("on"); else el.classList.remove("on");
    });
  }
  bRefresh();
  $("admBAll").onclick=()=>{ bSelected=new Set(ALL_SLOTS); bRefresh(); };
  $("admBHour").onclick=()=>{ bSelected=new Set(ALL_SLOTS.filter(t=>t.endsWith(":00"))); bRefresh(); };
  $("admBNone").onclick=()=>{ bSelected.clear(); bRefresh(); };
  $("admBAM").onclick=()=>{ bSelected=new Set(ALL_SLOTS.filter(t=>parseInt(t)<12)); bRefresh(); };
  $("admBPM").onclick=()=>{ bSelected=new Set(ALL_SLOTS.filter(t=>parseInt(t)>=12)); bRefresh(); };
  function switchTab(k){
    bMode=k;
    $("admTabWeekday").classList.toggle("on", k==="weekday");
    $("admTabWeekend").classList.toggle("on", k==="weekend");
    $("admBapply").textContent = k==="weekday" ? "套用到這段期間的「平日」" : "套用到這段期間的「假日」";
  }
  $("admTabWeekday").onclick=()=>switchTab("weekday");
  $("admTabWeekend").onclick=()=>switchTab("weekend");

  function ymd(d){ return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }

  $("admBapply").onclick=async ()=>{
    const startV=$("admBStart").value, endV=$("admBEnd").value;
    if(!startV || !endV){ $("admBmsg").className="adm-msg err"; $("admBmsg").textContent="請先選開始日和結束日。"; return; }
    const start=new Date(startV+"T00:00:00"), end=new Date(endV+"T00:00:00");
    if(end<start){ $("admBmsg").className="adm-msg err"; $("admBmsg").textContent="結束日不能早於開始日喔。"; return; }
    const slots=[...bSelected].filter(t=>ALL_SLOTS.indexOf(t)>=0).sort();
    const dates=[];
    for(let d=new Date(start); d<=end; d.setDate(d.getDate()+1)){
      const wd=d.getDay();
      const isWeekend = (wd===0 || wd===6);
      if(bMode==="weekday" && !isWeekend) dates.push(ymd(d));
      if(bMode==="weekend" && isWeekend) dates.push(ymd(d));
    }
    if(dates.length===0){ $("admBmsg").className="adm-msg err"; $("admBmsg").textContent="這段期間內沒有符合的日子，換個範圍或切換平日/假日試試。"; return; }
    if(dates.length>80){ $("admBmsg").className="adm-msg err"; $("admBmsg").textContent="一次最多排 80 天，請縮短範圍。"; return; }
    const btn=$("admBapply"); btn.disabled=true;
    $("admBmsg").textContent=""; $("admBprog").textContent="";
    const label = bMode==="weekday"?"平日":"假日";
    // 批次改用 JSONP，一天一天送，確保後端有驗證 userId
    for(let i=0;i<dates.length;i++){
      $("admBprog").textContent = `套用中… ${i+1}/${dates.length}（${dates[i]}）`;
      await new Promise(resolve=>{
        const cb="batchCB_"+Date.now()+"_"+i;
        const timer=setTimeout(()=>{ cleanup(); resolve(); }, 7000);
        function cleanup(){ delete window[cb]; const s=document.getElementById(cb); if(s)s.remove(); clearTimeout(timer); }
        window[cb]=function(){ cleanup(); resolve(); };
        const sc=document.createElement("script"); sc.id=cb;
        sc.src=SCRIPT_URL+"?action=saveSlots&date="+encodeURIComponent(dates[i])
             +"&slots="+encodeURIComponent(slots.join(","))
             +"&userId="+encodeURIComponent(st.userId||"")
             +"&callback="+cb;
        sc.onerror=()=>{ cleanup(); resolve(); };
        document.body.appendChild(sc);
      });
      await new Promise(r=>setTimeout(r,250));
    }
    $("admBprog").textContent="";
    $("admBmsg").className="adm-msg ok";
    $("admBmsg").textContent = `✓ 已套用！這段期間共 ${dates.length} 個${label}都設好了。要單獨改某天，用下方單日設定即可。`;
    // 清除客人預約頁的月份快取
    for(const k in monthCache) delete monthCache[k];
    btn.disabled=false;
  };

  // 預設把開始日填今天、結束日填 4 週後
  (function(){
    const t=new Date(); const e=new Date(); e.setDate(e.getDate()+28);
    $("admBStart").value=ymd(t); $("admBEnd").value=ymd(e);
  })();
})();

/* 啟動：先讓客人選服務 */
show(2);
