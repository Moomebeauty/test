  wrap.classList.add("open");
  return wrap;
}

function toggleCat(id,wrap){ if(wrap.classList.contains("open")) openCats.add(id); else openCats.delete(id); }

/* 建立一張服務卡片 */
function buildSvcCard(it,cat){
  const d=document.createElement("div");
  d.className="svc"+(it.combo?" combo":"")+(it.vip?" vip":"")+(it.free?" free":"")+(st.services.indexOf(it.key)>=0?" sel":"");
  const grayTxt = [it.desc, it.durText].filter(Boolean).join(" ・ ");
  const mtHtml = grayTxt ? `<div class="mt">${grayTxt}</div>` : "";
  const subHtml = it.sub ? `<div class="sub-nm">${it.sub}</div>` : "";
  const newBadge = it.tag ? `<span class="new-badge">${it.tag}</span>` : "";
  const giftHtml = it.gift ? `<div class="gift-line">${it.gift}<span class="gift-free">免費</span></div>` : "";
  const durShow = it.dur ? (it.dur>=60 ? `⏱ ${Math.floor(it.dur/60)} 時${it.dur%60?` ${it.dur%60} 分`:""}` : `⏱ ${it.dur} 分`) : "";
  const priceRow = it.vip ? `<span class="p-now">已儲值方案</span>`
    : it.free ? `<span class="p-now free">新客贈送</span>`
    : (it.orig ? `<span class="p-was">$${it.orig.toLocaleString()}</span><span class="p-now">$${it.price.toLocaleString()}</span>`
               : `<span class="p-now">$${it.price.toLocaleString()}</span>`);
  d.innerHTML=`<div class="info"><div class="nm">${it.name}${newBadge}</div>${subHtml}${mtHtml}${giftHtml}<div class="meta">${durShow?`<span class="dur">${durShow}</span>`:""}<span class="prices">${priceRow}</span></div></div>`;
  d.onclick=()=>{ const i=st.services.indexOf(it.key);
    if(i>=0)st.services.splice(i,1); else st.services.push(it.key);
    afterServiceChange(); renderServices(); };
  return d;
}

/* 大項目 → 跳出對話框選細項（同一大項目只能選一個）*/
function openVariantModal(pk){
  $("vTitle").textContent = pk.title;
  $("vSub").textContent = pk.multi ? "可複選多個項目，選好按完成" : "請選擇最符合您狀況的方案（擇一）";
  $("vClose").textContent = pk.multi ? "完成" : "關閉";
  const box=$("vList");
  function draw(){
    box.innerHTML="";
    let lastG=null;
    pk.options.forEach(k=>{
      const it=ITEM_MAP[k]; if(!it)return;
      if(it.group && it.group!==lastG){
        const g=document.createElement("div"); g.className="vgroup"; g.textContent=it.group;
        box.appendChild(g); lastG=it.group;
      }
      const on = st.services.indexOf(k)>=0;
      const d=document.createElement("div");
      d.className="vrow"+(on?" sel":"");
      const sub = [it.sub, it.desc].filter(Boolean).join(" · ");
      const pr = it.vip ? "已儲值方案" : (it.price>0 ? "$"+it.price.toLocaleString() : "免費");
      d.innerHTML=`<span class="v-check${pk.multi?"":" radio"}">${on?"✓":""}</span>
        <div class="v-left"><div class="v-nm">${it.name}</div>${sub?`<div class="v-sub">${sub}</div>`:""}</div>
        <div class="v-pr${it.price>0?"":" gift"}">${pr}</div>`;
      d.onclick=()=>{
        const i=st.services.indexOf(k);
        if(pk.multi){
          if(i>=0) st.services.splice(i,1); else st.services.push(k);
          draw(); afterServiceChange();
        }else{
          pk.options.forEach(o=>{ const j=st.services.indexOf(o); if(j>=0) st.services.splice(j,1); });
          if(i<0) st.services.push(k);
          $("variantModal").style.display="none";
          renderServices(); afterServiceChange();
        }
      };
      box.appendChild(d);
    });
    // 複選：下方即時顯示已選幾項、合計多少，按鈕也跟著變
    if(pk.multi){
      const chosen=pk.options.filter(k=>st.services.indexOf(k)>=0);
      const sum=chosen.reduce((a,k)=>a+(ITEM_MAP[k]?ITEM_MAP[k].price:0),0);
      $("vSum").style.display = chosen.length ? "block" : "none";
      $("vSum").textContent = `已選 ${chosen.length} 項・NT$ ${sum.toLocaleString()}`;
      $("vClose").textContent = chosen.length ? `完成（已選 ${chosen.length} 項）` : "先不選，關閉";
    }else{
      $("vSum").style.display="none";
    }
  }
  draw();
  $("vClose").onclick=()=>{ $("variantModal").style.display="none"; renderServices(); afterServiceChange(); };
  $("variantModal").style.display="flex";
}

