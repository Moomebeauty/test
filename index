/* 「看完整月曆」按鈕 → 平滑捲到月曆 */
$("fastAll").onclick=()=>{ $("calSec").scrollIntoView({behavior:"smooth", block:"start"}); };
async function loadFastest(){
  const my=++fastSeq;
  calTouched=false;
  $("fastCard").style.display="block";
  $("fastBody").innerHTML=`<div class="fast-loading">🔍 正在幫你找最快可預約的時段…</div>`;
