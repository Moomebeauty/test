/* 抓某月資料：逾時 18 秒、失敗自動重試 2 次、失敗絕不寫入快取 */
function fetchMonth(ym, attempt, hasOld){
  const cb="monthCB_"+Date.now()+"_"+attempt;
  let done=false;
  const timer=setTimeout(()=>{ if(done)return; cleanup(); retryOrFail(); },18000);
  function cleanup(){ done=true; delete window[cb]; const el=document.getElementById(cb); if(el)el.remove(); clearTimeout(timer); }
  function retryOrFail(){
    if(attempt<2){ setTimeout(()=>fetchMonth(ym, attempt+1, hasOld), 900); }   // 再試
    else if(!hasOld){ showCalError(); }                                        // 真的失敗才報錯
  }
  window[cb]=function(res){
    if(done)return; cleanup();
    // 只接受「確實帶回 month 資料」的回應，否則視為失敗（不會誤判成全部已滿）
    if(!res || typeof res.month!=="object" || res.month===null){ retryOrFail(); return; }
    monthData = res.month;
    monthStatus = res.status || {};
    monthCache[ym]={data:monthData, stat:monthStatus, at:Date.now()};
    if(ymStr()===ym) renderCal();
    prefetchMonth(viewYM.y, viewYM.m+1);
  };
  const el=document.createElement("script"); el.id=cb;
  el.src=SCRIPT_URL+"?action=getMonth&ym="+encodeURIComponent(ym)+"&_t="+Date.now()+"&callback="+cb;
  el.onerror=()=>{ if(done)return; cleanup(); retryOrFail(); };
  document.body.appendChild(el);
}

/* 讀取失敗時，明確告知，不要讓畫面看起來像「全部已滿」*/
