  .modal-body .mw{color:var(--ink)}
  .modal-body .mem{font-weight:600;color:var(--ink);margin:4px 0}
  /* 新客/舊客身分標籤 */
  .tag-new,.tag-old{display:inline-block;font-size:11px;font-weight:700;color:#fff;
    padding:2px 9px;border-radius:6px;margin-right:7px;letter-spacing:.08em;vertical-align:middle}
  .tag-new{background:#b5605f}      /* 新客：暖磚紅，醒目 */
  .tag-old{background:#7c8a6a}      /* 舊客：橄欖綠，區隔 */
  .modal-card .cta{margin-top:16px;flex-shrink:0}
  .notice h4{font-family:"Noto Serif TC",serif;font-size:15px;margin:14px 0 4px;color:var(--taupe-deep)}
  .notice h4:first-child{margin-top:0}
  .notice .warn{color:var(--ink)} .notice .em{font-weight:600}
  .agree{display:flex;align-items:flex-start;gap:10px;margin-top:16px;cursor:pointer;font-size:14px;padding:0 4px}
  .agree input{width:20px;height:20px;margin-top:3px;accent-color:var(--taupe);flex-shrink:0}

  .sumcard{background:var(--cream-soft);border:1px solid var(--line);border-radius:18px;padding:6px 20px;margin:0 4px}
  .sumrow{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px dashed var(--sand);font-size:14px}
  .sumrow:last-child{border-bottom:none}
  .sumrow .k{color:var(--muted)} .sumrow .v{font-weight:600;text-align:right;font-family:"Noto Serif TC",serif;max-width:60%}

  .cta{display:block;width:100%;margin-top:30px;padding:16px;border:1px solid var(--brand);border-radius:26px;
    background:#fff;color:var(--brand);font:inherit;font-weight:600;font-size:15px;letter-spacing:.1em;
    cursor:pointer;transition:transform .2s ease,background .2s}
  .cta:active{transform:scale(.985);background:var(--brand-soft)}
  .cta:disabled{border-color:var(--divider);color:var(--grey);cursor:not-allowed;background:#fff}
  .ghost{background:none;border:1px solid var(--line);color:var(--muted);margin-top:10px;padding:13px;border-radius:14px;width:100%;font:inherit;cursor:pointer;font-size:14px}
  .backbtn{display:block;width:100%;margin-top:18px;padding:14px;border:1.5px solid var(--taupe);border-radius:14px;
    background:#ece1d0;color:var(--taupe-deep);font:inherit;font-size:14.5px;font-weight:600;cursor:pointer;letter-spacing:.04em}
  .backbtn:hover{background:#e3d5c0}

  .done{text-align:center;padding:10px 6px}
  .done .tick{width:58px;height:58px;border-radius:50%;background:var(--ok);display:grid;place-items:center;margin:0 auto 16px;color:#fff;font-size:28px}
  .done h3{font-family:"Noto Serif TC",serif;font-size:21px;margin-bottom:8px}
  .done p{font-size:13.5px;color:var(--muted)}
  .paybox{background:var(--cream-soft);border:1px dashed var(--rose);border-radius:16px;padding:16px;margin:18px 4px;font-size:13.5px;line-height:1.9;text-align:left}
  .infobar{display:block;width:calc(100% - 48px);margin:14px 24px 0;padding:13px;border:1px solid var(--line);
    border-radius:14px;background:var(--cream-soft);color:var(--taupe-deep);font:inherit;font-size:14px;
    font-weight:600;letter-spacing:.06em;cursor:pointer;text-align:center}
  .infobar:hover{background:#ece1d0;border-color:var(--taupe)}
  .infoblock{background:var(--cream-soft);border:1px solid var(--line);border-radius:16px;padding:16px 18px;margin:0 4px 14px;font-size:14px;line-height:1.85}
  .infoblock .lead{font-size:15px;color:var(--ink);margin-bottom:4px}
  .infoblock .lead2{font-family:"Noto Serif TC",serif;color:var(--taupe-deep);letter-spacing:.06em;margin-bottom:8px}
  .infoblock .svc-line{color:var(--muted);font-size:13.5px;letter-spacing:.04em}
  .infoblock .ibt{font-family:"Noto Serif TC",serif;font-size:15px;font-weight:600;color:var(--taupe-deep);margin-bottom:6px}
  .notecard{background:var(--cream-soft);border:1px solid var(--line);border-radius:16px;padding:16px 18px;margin:16px 4px;text-align:left;font-size:13.5px;line-height:1.95}
  .notecard .nctitle{font-family:"Noto Serif TC",serif;font-size:15px;color:var(--taupe-deep);margin-bottom:8px}
  .navi{display:inline-block;margin-top:10px;padding:11px 22px;background:var(--ink);color:var(--cream-soft);
    border-radius:12px;text-decoration:none;font-size:14px;font-weight:600;letter-spacing:.05em}
  .gcal{display:block;margin:6px auto 0;padding:14px 22px;background:var(--taupe);color:var(--cream-soft);
    border-radius:14px;text-decoration:none;font-size:15px;font-weight:600;letter-spacing:.08em}
  .gcal:hover{background:var(--taupe-deep)}
  .loading{text-align:center;color:var(--taupe-deep);font-size:14px;padding:34px 16px;line-height:1.7;letter-spacing:.03em}
  /* 底部導覽列 */
  .tabbar{position:fixed;left:0;right:0;bottom:0;z-index:40;display:flex;max-width:480px;margin:0 auto;
