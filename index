    padding:8px 0 calc(8px + env(safe-area-inset-bottom))}
  .tab{flex:1;background:none;border:none;font:inherit;display:flex;flex-direction:column;align-items:center;
    gap:4px;padding:9px 0 7px;color:var(--grey);font-size:11px;letter-spacing:.1em;cursor:pointer;
    transition:.2s;position:relative}
  .tab .ti{font-size:18px;line-height:1}
  .tab.on{color:var(--brand)}
  .tab.on::before{content:"";position:absolute;top:0;left:22%;right:22%;height:2px;background:var(--brand);
    border-radius:2px}
  body{padding-bottom:74px}
  /* 上一步／下一步 */
  .navrow{display:flex;gap:12px;margin-top:28px}
  .navbtn2{flex:1;padding:15px 10px;border:1px solid var(--brand);border-radius:26px;background:#fff;
    color:var(--brand);font:inherit;font-size:14px;letter-spacing:.06em;cursor:pointer;font-weight:600;
    transition:transform .18s ease,background .2s}
  .navbtn2:active{transform:scale(.985);background:var(--brand-soft)}
  .navbtn2:disabled{opacity:.3;cursor:not-allowed}
  footer{position:relative;z-index:1;padding:34px 28px 48px;text-align:center;color:var(--muted);font-size:11px;letter-spacing:.34em;border-top:1px solid rgba(140,124,106,.12)}
  @media (prefers-reduced-motion:reduce){*{animation:none!important}}

  /* ===== 我的預約 ===== */
  .mine-card{background:#fff;border:1px solid var(--brand);border-radius:18px;padding:18px 18px 16px;margin:0 4px 16px}
  .mine-when{display:flex;align-items:baseline;gap:10px;margin-bottom:6px}
  .mine-date{font-size:18px;font-weight:700;color:var(--ink)}
  .mine-wk{font-size:13px;color:var(--brand-deep);letter-spacing:.08em}
  .mine-time{margin-left:auto;font-size:18px;font-weight:700;color:var(--brand)}
  .mine-svc{font-size:13.5px;color:var(--ink);line-height:1.7}
  .mine-meta{font-size:12px;color:var(--muted);margin-top:3px}
  .mine-btns{display:flex;gap:10px;margin-top:14px}
  .mine-btn{flex:1;font:inherit;font-size:14px;font-weight:600;padding:12px 6px;border-radius:22px;cursor:pointer;
    border:1px solid var(--brand);background:#fff;color:var(--brand-deep);letter-spacing:.06em}
  .mine-btn:active{background:var(--brand-soft)}
  .mine-btn.danger{border-color:#c9a3a0;color:#9c4a3f}
  .mine-btn:disabled{opacity:.45;cursor:not-allowed}
  .mine-lock{margin-top:12px;font-size:12.5px;color:#9c4a3f;background:#f7eeec;border-radius:10px;padding:9px 12px;line-height:1.6}
  .mine-empty{text-align:center;color:var(--muted);font-size:14px;line-height:1.9;padding:30px 12px}
  .resch-bar{position:relative;z-index:2;margin:10px 18px 0;padding:12px 14px;border-radius:14px;
    background:#f3ece2;border:1px solid var(--brand);color:var(--brand-deep);font-size:13.5px;line-height:1.6;
    display:none;align-items:center;gap:10px}
