CATEGORIES.forEach(c=>{
  c.items.forEach(it=>{ ITEM_MAP[it.key]=Object.assign({}, it, {type:"main", catId:c.id}); });
  c.addons.forEach(ad=>{ ITEM_MAP[ad.key]=Object.assign({}, ad, {type:"addon", catId:c.id, dur:ad.min||ADDON_MIN}); });
});
const STUDIO = { name:SHOP.name, location:SHOP.address+(SHOP.addressNote?"（"+SHOP.addressNote+"）":"") };
