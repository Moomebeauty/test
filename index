/* ★ 老師本人的 LINE userId — 只有這個 userId 進來，⚙️ 按鈕才會出現 */
const OWNER_USERID = SHOP.OWNER_USERID;

const $=id=>document.getElementById(id);

/* ===== 把 settings.js 的店家資料填進畫面 ===== */
(function applyShop(){
  const esc=t=>String(t).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
  const tags=t=>t.replace(/\[(新客|舊客|提醒)\]/g,(m,w)=>'<span class="'+(w==="舊客"?"tag-old":"tag-new")+'">'+w+'</span>');
  const line=(t,warnCls,emCls)=>{ let cls="", x=String(t);
    if(x[0]==="!"){ cls=warnCls; x=x.slice(1); } else if(x[0]==="*"){ cls=emCls; x=x.slice(1); }
    return '<p'+(cls?' class="'+cls+'"':'')+'>'+tags(esc(x))+'</p>'; };
  const N=SHOP.notice||[];
  $("noticeModalBody").innerHTML=N.map(sec=>'<p class="mh">'+esc(sec.title)+'</p>'+sec.lines.map(l=>line(l,"mw","mem")).join("")).join("");
  $("noticeP3").innerHTML=N.map(sec=>'<h4>'+esc(sec.title)+'</h4>'+sec.lines.map(l=>line(l,"warn","em")).join("")).join("");
  document.title=SHOP.name+" · 線上預約";
  $("tbTitle").textContent="我要預約 · "+SHOP.name;
  $("tbLogo").src=SHOP.logo||"logo.jpg";
  $("shopFooter").textContent="By "+SHOP.teacher;
  $("cnote").placeholder=SHOP.notePlaceholder||"";
  $("payBox").innerHTML=(SHOP.depositBox||[]).map(esc).join("<br>");
  if(!SHOP.deposit) $("payBox").style.display="none";
  const addr=esc(SHOP.address)+(SHOP.addressNote?"<br>（"+esc(SHOP.addressNote)+"）":"");
  $("doneNotes").innerHTML='<p>‣ 地址：'+esc(SHOP.address)+(SHOP.addressNote?"（"+esc(SHOP.addressNote)+"）":"")+'</p>'
    +(SHOP.parking||[]).concat(SHOP.arrival||[]).map(t=>'<p>‣ '+esc(t)+'</p>').join("");
  $("infoSlogan").textContent=SHOP.slogan||"";
  $("infoAddr").innerHTML=addr;
  $("infoParking").innerHTML=(SHOP.parking||[]).map(t=>'<p>'+esc(t)+'</p>').join("");
  $("infoArrival").innerHTML=(SHOP.arrival||[]).map(t=>'<p>'+esc(t)+'</p>').join("");
  if(!SHOP.photoConsent){ ["photoLbl","photoPick","sPhotoRow"].forEach(id=>$(id).style.display="none"); }
  const maxP=Math.max(1,SHOP.maxPeople||1);
  let ph=""; for(let i=1;i<=maxP;i++) ph+='<div class="ppl'+(i===1?" sel":"")+'" data-n="'+i+'">'+i+' 位</div>';
  $("pplPick").innerHTML=ph;
  if(maxP===1){ $("pplLbl").style.display="none"; $("pplPick").style.display="none"; }
})();
const st = { userId:null, name:"", phone:"", note:"", services:[], addons:[], date:null, time:null, people:1, photo:"同意公開" };
let monthData = {};      // 當月：日期 -> 可預約時段
let monthStatus = {};    // 當月：日期 -> 休假／進修
// 全部時段：10:00 到 20:30，每 30 分一格（與 admin 一致）。沒開放/已約都顯示「已約」
const ALL_TIMES = (function(){ const a=[]; for(let t=SHOP.openHour*60;t<=SHOP.closeHour*60;t+=SHOP.slotStep){ const h=Math.floor(t/60),m=t%60; a.push((h<10?"0"+h:h)+":"+(m<10?"0"+m:m)); } return a; })();
let viewYM = null;       // 目前顯示的年月

/* 面板切換。面板 id 與「邏輯步驟」對應：
   邏輯順序：服務(p2)→日期(p0)→時段(p1)→須知資料(p3)→確認(p4)
   進度點 d0..d4 依邏輯順序亮。*/
const STEP_OF_PANEL = { 2:0, 0:1, 1:1, 3:2, 4:3 };
function show(n){
  for(let i=0;i<=6;i++){ const el=$("p"+i); if(el) el.classList.toggle("show", i===n); }
  const stepsBar=document.querySelector(".steps");
  if(stepsBar) stepsBar.style.display = (n===5 || n===6) ? "none" : "flex";
  // 改期提示條：只在選日期、選時段、確認頁顯示
  const rb=$("reschBar");
  if(rb) rb.classList.toggle("show", !!st.reschedule && (n===0 || n===1 || n===4));
  const infobar=$("openInfo");
  if(infobar) infobar.style.display = "none";
  const step = STEP_OF_PANEL[n];
  for(let i=0;i<=3;i++){ const el=$("d"+i); if(!el)continue;
    el.classList.toggle("on", i===step);
    el.classList.toggle("done", step!==undefined && i<step); }
  syncTab(n);
