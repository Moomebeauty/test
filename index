/* ===== 最快可預約：往後看 3 個月，找出最快的空檔＋最近的假日空檔 ===== */
function fetchMonthData(ym){
  return new Promise(resolve=>{
    const c=monthCache[ym];
    if(c && Date.now()-c.at < CACHE_TTL) return resolve(c);
    const cb="fastCB_"+ym.replace("-","")+"_"+Date.now();
    const timer=setTimeout(()=>{ cleanup(); resolve(null); },18000);
    function cleanup(){ delete window[cb]; const s=document.getElementById(cb); if(s)s.remove(); clearTimeout(timer); }
    window[cb]=function(res){ cleanup();
      if(res && typeof res.month==="object" && res.month!==null){
        const v={data:res.month, stat:res.status||{}, at:Date.now()};
        monthCache[ym]=v; resolve(v);
      }else resolve(null);
    };
    const s=document.createElement("script"); s.id=cb;
    s.src=SCRIPT_URL+"?action=getMonth&ym="+encodeURIComponent(ym)+"&_t="+Date.now()+"&callback="+cb;
    s.onerror=()=>{ cleanup(); resolve(null); };
    document.body.appendChild(s);
  });
}
