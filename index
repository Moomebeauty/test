/* 目前這筆的服務名稱／時長／金額（一般預約 or 改期） */
function curSvcText(){ return st.reschedule ? st.reschedule.service : svcNames() + (st.people>1 ? "（" + st.people + " 位）" : ""); }
function curDur(){ return st.reschedule ? (Number(st.reschedule.dur)||120) : totalDur(); }
/* 防止連點：改用 ontouchstart + onclick 雙保險；一但送出過就完全鎖死按鈕 */
let submitLock = false;
function doSubmit(){
  if(submitLock || st.submitted) return;   // 已經在送 or 已送過 → 直接忽略
  submitLock = true;
  const btn=$("submit"); btn.disabled=true; btn.textContent="送出中…";
  const r = st.reschedule;
  const payload = r
    ? { bookingId:st.bookingId, rescheduleOf:r.key, name:r.name, phone:r.phone,
        service:r.service, date:st.date, time:st.time, dur:curDur(), price:r.price,
        note:r.note, userId:st.userId||"" }
    : { bookingId:st.bookingId, name:st.name, phone:st.phone,
        service:curSvcText(), people:st.people||1,
        date:st.date, time:st.time, dur:totalDur(), price:totalPrice(),
        note:SHOP.photoConsent ? (st.note ? st.note+"｜" : "")+"作品照："+st.photo : st.note, userId:st.userId||"" };
  fetch(SCRIPT_URL,{ method:"POST", mode:"no-cors", headers:{"Content-Type":"text/plain;charset=utf-8"},
    body:JSON.stringify(payload)
  }).catch(()=>{});
  st.submitted = true;
  btn.textContent="確認時段中…";
  // ★ 送出後向後端確認：這筆真的成立了嗎？（同一秒有人搶走同一個時段時，這裡會知道）
  let tries=0;
  (function poll(){
    tries++;
    const cb="bkStat_"+Date.now();
    const timer=setTimeout(()=>{ cleanup(); next(); },5000);
    function cleanup(){ delete window[cb]; const el=document.getElementById(cb); if(el)el.remove(); clearTimeout(timer); }
    function next(){ if(tries>=10) showDone(); else setTimeout(poll,1500); }   // 等不到就照常顯示完成
    window[cb]=function(res){ cleanup();
      if(res && res.state==="ok") showDone();
      else if(res && res.state==="taken") slotTaken();
      else next();
    };
    const sc=document.createElement("script"); sc.id=cb;
    sc.src=SCRIPT_URL+"?action=bookingStatus&bookingId="+encodeURIComponent(st.bookingId)+"&_t="+Date.now()+"&callback="+cb;
    sc.onerror=()=>{ cleanup(); next(); };
    document.body.appendChild(sc);
  })();
}
/* 預約成立 → 顯示完成畫面 */
function showDone(){
  const r = st.reschedule, btn=$("submit");
  // 清掉快取，下次切回會重新抓到最新（被約走的時段會消失、改期釋放的時段會出現）
  if(st.date){ delete monthCache[st.date.substring(0,7)]; }
  if(r && r.date){ delete monthCache[r.date.substring(0,7)]; }
  mineCache = null;
  const wd=["日","一","二","三","四","五","六"][new Date(st.date+"T00:00:00").getDay()];
  $("doneTitle").textContent = r ? "改期完成" : "預約完成";
  $("doneDate").textContent=(r ? "新的預約時間：" : "預約日期為：")+st.date+"（週"+wd+"）"+st.time;
  $("payBox").style.display = (r || !SHOP.deposit) ? "none" : "";   // 改期不用再付定金
  $("gcalBtn").href = buildGcalLink();
  btn.style.display="none"; $("done").style.display="block";
