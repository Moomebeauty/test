/* ===== 我的預約：查看、取消、改期 ===== */
let mineCache = null;   // 最近一次抓到的清單
const WEEK = ["日","一","二","三","四","五","六"];

/* 等 LINE 身分抓到（最多等 4 秒）再做事 */
function whenUser(cb){
  if(st.userId) return cb(true);
  let n=0;
  const t=setInterval(()=>{ n++;
    if(st.userId){ clearInterval(t); cb(true); }
    else if(n>=20){ clearInterval(t); cb(false); }
  },200);
}

function loadMine(){
  const box=$("mineList");
  box.innerHTML=`<div class="loading">🌿 正在查詢你的預約，請稍候一下下～</div>`;
  whenUser(ok=>{
    if(!ok){
      box.innerHTML=`<div class="mine-empty">需要從 <b>LINE</b> 打開預約頁，<br>才查得到你的預約喔 ♡</div>`;
      return;
    }
    const cb="mineCB_"+Date.now();
    const timer=setTimeout(()=>{ cleanup(); showMineError(); },15000);
    function cleanup(){ delete window[cb]; const s=document.getElementById(cb); if(s)s.remove(); clearTimeout(timer); }
    window[cb]=function(res){ cleanup();
      if(!res || !res.ok || !Array.isArray(res.bookings)){ showMineError(); return; }
      mineCache=res;
      renderMine(res);
    };
    const s=document.createElement("script"); s.id=cb;
    s.src=SCRIPT_URL+"?action=myBookings&userId="+encodeURIComponent(st.userId)+"&_t="+Date.now()+"&callback="+cb;
    s.onerror=()=>{ cleanup(); showMineError(); };
    document.body.appendChild(s);
  });
}
function showMineError(){
  $("mineList").innerHTML=`<div class="mine-empty">🌧 讀取失敗了，可能是網路不穩<br>請按上方「↻ 重新整理」再試一次</div>`;
}
$("mineRefresh").onclick=loadMine;

function renderMine(res){
  const box=$("mineList"); box.innerHTML="";
  const lim=res.limitHours||24;
  $("mineSub").textContent=`這裡會列出你還沒到的預約。預約前 ${lim} 小時以前，可以自己取消或改期。`;
  if(!res.bookings.length){
    box.innerHTML=`<div class="mine-empty">目前沒有即將到來的預約 ♡<br>想預約的話，點下方「🗓 我要預約」</div>`;
    return;
  }
  res.bookings.forEach(b=>{
    const d=new Date(b.date+"T00:00:00");
    const card=document.createElement("div"); card.className="mine-card";
    const priceTxt=(b.price!=="" && b.price!=null) ? `NT$ ${Number(b.price).toLocaleString()}` : "";
    card.innerHTML=`
      <div class="mine-when">
        <span class="mine-date">${d.getMonth()+1}月${d.getDate()}日</span>
        <span class="mine-wk">星期${WEEK[d.getDay()]}</span>
        <span class="mine-time">${b.time}</span>
      </div>
      <div class="mine-svc"></div>
      <div class="mine-meta">約 ${b.dur} 分鐘${priceTxt?"　・　"+priceTxt:""}</div>`;
    card.querySelector(".mine-svc").textContent=b.service;   // 用 textContent 避免特殊字元出錯
    if(b.canChange){
      const row=document.createElement("div"); row.className="mine-btns";
      const bRes=document.createElement("button"); bRes.className="mine-btn"; bRes.textContent="改期";
      const bCan=document.createElement("button"); bCan.className="mine-btn danger"; bCan.textContent="取消預約";
      bRes.onclick=()=>startReschedule(b);
      bCan.onclick=()=>cancelMine(b, bCan, bRes);
      row.appendChild(bRes); row.appendChild(bCan); card.appendChild(row);
    }else{
      const lock=document.createElement("div"); lock.className="mine-lock";
      lock.textContent=`⏳ 距離預約已不到 ${lim} 小時，無法在網頁上取消或改期，如有需要請直接傳 LINE 給老師 ♡`;
      card.appendChild(lock);
    }
    box.appendChild(card);
  });
}

function cancelMine(b, btn, other){
  const d=new Date(b.date+"T00:00:00");
  const ok=confirm(`確定要取消這筆預約嗎？\n\n${d.getMonth()+1}月${d.getDate()}日（週${WEEK[d.getDay()]}）${b.time}\n${b.service}\n\n取消後這個時段會開放給其他客人。`);
  if(!ok) return;
  btn.disabled=true; other.disabled=true; btn.textContent="取消中…";
  const cb="canCB_"+Date.now();
  const timer=setTimeout(()=>{ cleanup(); fail("連線逾時，請稍後再試一次"); },20000);
  function cleanup(){ delete window[cb]; const s=document.getElementById(cb); if(s)s.remove(); clearTimeout(timer); }
  function fail(msg){ alert(msg); btn.disabled=false; other.disabled=false; btn.textContent="取消預約"; }
  window[cb]=function(res){ cleanup();
    if(res && res.ok){
      delete monthCache[b.date.substring(0,7)];
      alert("已為你取消預約 ✓\nLINE 也會收到一則取消通知。");
      loadMine();
    }else if(res && res.error==="too_late"){
      alert(`距離預約已不到 ${res.limitHours||24} 小時，無法在網頁上取消，請直接傳 LINE 給老師 ♡`);
      loadMine();
    }else if(res && res.error==="not_found"){
      alert("找不到這筆預約，可能已經取消過了。");
      loadMine();
    }else{
      fail("取消失敗了，請稍後再試，或直接傳 LINE 給老師。");
    }
  };
  const s=document.createElement("script"); s.id=cb;
  s.src=SCRIPT_URL+"?action=cancelBooking&userId="+encodeURIComponent(st.userId||"")
       +"&bookingId="+encodeURIComponent(b.key)+"&_t="+Date.now()+"&callback="+cb;
  s.onerror=()=>{ cleanup(); fail("連線失敗，請檢查網路後再試一次"); };
  document.body.appendChild(s);
}

