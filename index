<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>線上預約</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Noto+Sans+TC:wght@300;400;500;700&display=swap" rel="stylesheet">
<script src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>
<!-- ★ 店家設定都在 settings.js，這個檔案不用改 -->
<script src="settings.js"></script>
<style>
  :root{
    --brand:#8c7c6a;            /* 主色：LOGO 灰褐 */
    --brand-deep:#6f6151;
    --brand-soft:#f3ece2;       /* 奶茶米白 */
    --ink:#4a4038;              /* 暖棕黑，文字 */
    --grey:#b3a596;             /* 次要／未選中 */
    --divider:#ece4d9;          /* 分隔線 */
    --white:#fff; --ivory:#fdfaf6;
    --taupe:#8c7c6a; --taupe-deep:#6f6151;
    --cream:#f3ece2; --cream-soft:#faf5ec; --sand:#e6dccb;
    --line:#ece4d9; --muted:#b3a596; --ok:#7c8a6a; --warn:#8c7c6a;
    --gold:#b99a63; --rose:#8c7c6a; --rose-soft:#f3ece2; --rose-deep:#6f6151;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{font-family:"Noto Sans TC","PingFang TC","Microsoft JhengHei",sans-serif;
    background:var(--ivory);color:var(--ink);line-height:1.8;letter-spacing:.02em;-webkit-font-smoothing:antialiased}
  .wrap{max-width:480px;margin:0 auto;min-height:100vh;background:var(--ivory);position:relative;overflow:hidden}
  .wrap::before{content:"";position:absolute;left:-30%;top:40%;width:120%;height:60%;
    background:radial-gradient(60% 50% at 30% 30%, rgba(140,124,106,.08), transparent 70%);pointer-events:none;z-index:0}

  .topbar{position:relative;z-index:2;display:flex;align-items:center;justify-content:center;
    padding:24px 22px 8px;background:var(--ivory)}
  .tb-title{font-size:16px;font-weight:600;color:var(--ink);letter-spacing:.06em}
  .tb-close{position:absolute;right:18px;top:50%;transform:translateY(-40%);background:none;border:none;
    font-size:19px;color:var(--ink);cursor:pointer;line-height:1;padding:4px}
  .logo-wrap,.brand,.moome,.slogan{display:none}
  .tb-logo{position:absolute;left:18px;top:50%;transform:translateY(-45%);
    width:46px;height:46px;object-fit:cover;border-radius:50%;opacity:1}
  /* 步驟列：純文字＋數字，無圓圈無連線 */
  .steps{display:flex;justify-content:space-between;align-items:baseline;padding:26px 22px 22px;
    position:relative;z-index:1;background:var(--ivory)}
  .stp{display:flex;align-items:baseline;gap:4px}
  .sn{font-size:19px;font-weight:700;color:var(--grey);transition:.2s}
  .sl{font-size:13px;color:var(--grey);letter-spacing:.04em;transition:.2s}
  .stp.on .sn,.stp.on .sl{color:var(--brand)}
  .stp.on .sl{font-weight:600}
  .stp.done .sn,.stp.done .sl{color:var(--ink)}
  .panel{position:relative;z-index:1;padding:34px 22px 44px;display:none}
  .panel.show{display:block;animation:fade .35s ease}
  @keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
  .ptitle{position:relative;font-size:22px;font-weight:400;letter-spacing:.18em;color:var(--ink);
    margin:0 4px 8px;padding-top:26px;font-family:"Noto Sans TC",sans-serif}
  .ptitle::before{content:attr(data-eb);position:absolute;top:0;left:0;
    font-family:"Cormorant Garamond",serif;font-style:italic;font-size:13px;font-weight:400;
    letter-spacing:.42em;color:var(--gold);text-transform:uppercase}
  .ptitle::after{content:"";position:absolute;left:0;bottom:-14px;width:34px;height:1.5px;
    background:linear-gradient(to right,var(--taupe),transparent)}
  .psub{font-size:13px;color:var(--muted);margin:26px 4px 24px;letter-spacing:.04em;line-height:1.9}

  /* 月曆 */
  .cal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;padding:0 4px}
  /* 頂部橫向注意事項卡片 */
  .notice-cards-label{font-family:"Noto Serif TC",serif;font-size:15px;font-weight:600;color:var(--taupe-deep);margin:2px 2px 12px}
  .notice-cards{display:flex;gap:12px;overflow-x:auto;padding:2px 2px 14px;margin-bottom:20px;
    scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch}
  .notice-cards::-webkit-scrollbar{height:0}
  .ncard{flex:0 0 78%;scroll-snap-align:start;background:var(--cream-soft);border:1px solid var(--line);
    border-radius:16px;padding:17px 18px;box-shadow:0 2px 10px rgba(140,124,106,.06)}
  .nc-no{font-family:"Noto Serif TC",serif;font-size:26px;font-weight:700;color:#c9a961;line-height:1;margin-bottom:9px}
  .nc-t{font-size:15px;font-weight:700;color:var(--ink);margin-bottom:6px}
  .nc-d{font-size:12.5px;color:var(--muted);line-height:1.75}
  .cal-head .mo{font-family:"Noto Sans TC",sans-serif;font-size:17px;font-weight:700;letter-spacing:.08em;color:var(--ink)}
  .navbtn{width:36px;height:36px;border-radius:50%;border:1px solid var(--line);background:var(--cream-soft);
    color:var(--taupe-deep);font-size:16px;cursor:pointer}
  .navbtn:disabled{opacity:.3;cursor:not-allowed}
  .calerr{text-align:center;color:var(--muted);font-size:13.5px;line-height:1.9;padding:34px 16px}
  .refreshbtn{display:block;margin:0 auto 14px;padding:7px 16px;border:1px solid var(--divider);
    border-radius:20px;background:#fff;color:var(--muted);font:inherit;font-size:12px;cursor:pointer;
    letter-spacing:.06em}
  .refreshbtn:active{background:var(--brand-soft);color:var(--brand-deep)}
  .week{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;margin-bottom:6px}
  .week div{text-align:center;font-size:12px;color:var(--muted);padding:4px 0}
  .grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
  .cell{aspect-ratio:1/1;border-radius:12px;display:flex;flex-direction:column;align-items:center;justify-content:center;
    font-family:"Noto Sans TC",sans-serif;font-size:16px;font-weight:600;border:1px solid transparent;position:relative}
  .cell.empty{visibility:hidden}
  .cell.open{background:var(--white);border-color:rgba(140,124,106,.35);color:var(--ink);cursor:pointer;font-weight:500}
  .cell.open:hover{background:#ece1d0}
  .cell.open .tagfree{font-size:9px;color:var(--ok);margin-top:1px}
  .cell.full{background:#efe6dd;color:#c2b5a2;cursor:not-allowed}
  .cell.full .tagfull{font-size:9px;color:var(--warn);margin-top:1px}
  .cell.closed{color:#cdc1b0;cursor:default}
  .cell.rest{background:#f2eee8;color:#a99a88;cursor:not-allowed}
  .cell.rest .tagrest{font-size:9px;color:#8c7c6a;margin-top:1px;letter-spacing:.04em}
  .cell.sel{background:var(--taupe);border-color:var(--taupe);color:var(--cream-soft)}
  .cell.sel .tagfree{color:var(--cream-soft)}
  /* 國定假日：數字轉紅、底部紅點標示 */
  .cell.holiday{color:#c0584a}
  .cell.holiday.closed{color:#d99b90}
  .cell.holiday .holi-tag{display:block;font-size:8px;line-height:1.1;color:#c0584a;margin-top:2px;
    max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-align:center}
  .cell.holiday.open .holi-tag{color:#c0584a}
  .cell.holiday .tagfree,.cell.holiday .tagfull{display:none}
  .cell{position:relative}
  .legend{display:flex;gap:16px;justify-content:center;margin-top:16px;font-size:12px;color:var(--muted)}
  .legend span{display:inline-flex;align-items:center;gap:5px}
  .lg{width:12px;height:12px;border-radius:4px;display:inline-block}
  .lg.open{background:var(--cream-soft);border:1px solid var(--taupe)}
  .lg.full{background:#efe6dd}
  .lg.holi{background:#f5d9d2;border:1px solid #c0584a}
  .lg.rest{background:#f2eee8;border:1px solid #cdbfae}

  /* 時段 */
  .daytitle{font-family:"Noto Serif TC",serif;font-size:16px;margin:6px 4px 12px;font-weight:600}
  .daysel{display:flex;align-items:baseline;gap:10px;background:var(--cream-soft);border:1px solid var(--line);
    border-radius:14px;padding:14px 18px;margin:0 4px 16px}
  .daysel .dnum{font-family:"Noto Serif TC",serif;font-size:22px;font-weight:700;color:var(--ink)}
  .daysel .dwk{font-size:14px;color:var(--taupe-deep);letter-spacing:.1em}
  .times{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}
  .sec-label{font-size:13px;color:var(--taupe-deep);letter-spacing:.1em;margin:4px 4px 10px;font-weight:600}
  .avail-card{background:#eef0e6;border:1px solid #d3d8c2;border-radius:18px;padding:16px 14px 14px;margin-bottom:8px}
  .avail-title{color:#6f7d56;margin:0 2px 12px;font-size:14px}
  .avail-title::before{content:"●";color:#8aa06a;margin-right:7px;font-size:11px;vertical-align:middle}
  .avail-card .slot{background:#fff;border:1.5px solid #b9c79a;color:#4a4038;font-weight:600}
  .avail-card .slot:hover{border-color:#8aa06a;box-shadow:0 4px 14px rgba(138,160,106,.2)}
  .avail-card .slot.sel{background:#8aa06a;color:#fff;border-color:#8aa06a}
  .full-note{text-align:center;background:#eef0e6;border:1px solid #d3d8c2;border-radius:16px;padding:20px;color:#6f7d56;font-size:14px;margin-bottom:8px}
  /* 「僅剩 N 個」小標籤 */
  .avail-title{display:flex;align-items:center}
  .few-badge{margin-left:auto;font-size:11px;font-weight:700;color:#fff;background:#b5605f;
    padding:2px 10px;border-radius:10px;letter-spacing:.05em}
  /* 時段已額滿：白色小卡＋淡色整點小標籤 */
  .full-card{margin-top:16px;background:#fff;border:1px solid var(--divider);border-radius:16px;padding:14px 16px 16px}
  .full-card .sec-full{margin:0 0 10px;color:var(--ink);font-weight:500;font-size:13.5px;letter-spacing:.06em}
  .full-chips{display:flex;flex-wrap:wrap;gap:6px}
  .full-chip{font-size:12px;color:#b3a596;background:#f3eee8;border-radius:8px;padding:4px 9px;letter-spacing:.02em}
  /* 最快可預約卡片 */
  .fast-card{background:#fff;border:1px solid var(--divider);border-radius:18px;padding:16px 16px 0;margin:38px 4px 26px;overflow:hidden}
  .fast-tip{font-size:12.5px;color:var(--muted);line-height:1.9;letter-spacing:.04em;
    padding-bottom:12px;margin-bottom:14px;border-bottom:1px dashed var(--divider)}
  .fast-h{font-size:13.5px;font-weight:700;color:var(--ink);margin:0 0 9px;letter-spacing:.04em}
  .fast-row{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:10px}
  .fast-date{font-size:12.5px;font-weight:600;color:var(--ink);width:80px;flex-shrink:0;cursor:pointer;line-height:1.3}
  .fast-hol{display:block;font-size:10px;color:#c0584a;font-weight:500}
  .fast-chip{font:inherit;font-size:12.5px;font-weight:600;padding:6px 8px;border-radius:10px;flex-shrink:0;
    border:1.5px solid #b9c79a;background:#f6f8f0;color:#4a4038;cursor:pointer}
  .fast-chip:active{background:#8aa06a;color:#fff;border-color:#8aa06a}
  .fast-more{font:inherit;font-size:12px;font-weight:600;color:var(--brand);background:var(--brand-soft);border:none;border-radius:10px;cursor:pointer;padding:7px 8px;flex-shrink:0}
  .fast-sep{border-top:1px dashed var(--divider);margin:6px 0 12px}
  .fast-loading{font-size:13px;color:var(--muted);text-align:center;padding:6px 0 12px}
  .fast-none{font-size:12.5px;color:var(--muted);margin:-2px 0 10px}
  .fast-all{display:block;width:calc(100% + 32px);margin:4px -16px 0;padding:13px 10px 12px;border:none;
    border-top:1px solid var(--divider);border-radius:0 0 18px 18px;background:var(--brand-soft);
    font:inherit;font-size:13.5px;font-weight:600;color:var(--brand-deep);letter-spacing:.05em;cursor:pointer}
  .fast-all:active{background:#ece1d0}
  .cal-sec{font-size:15px;font-weight:700;color:var(--ink);letter-spacing:.06em;margin:0 4px 14px;scroll-margin-top:12px}
  .slot{padding:14px 0;text-align:center;border:1px solid var(--divider);border-radius:12px;
    background:var(--white);font-size:15px;cursor:pointer;letter-spacing:.04em;
    font-family:"Noto Sans TC",sans-serif;font-weight:600;transition:transform .18s ease,border-color .18s}
  .slot:active{transform:scale(.96)}
  .slot:hover{border-color:var(--taupe)}
  .slot.sel{background:var(--taupe);color:var(--cream-soft);border-color:var(--taupe)}
  .slot.off{cursor:not-allowed;background:#f0e6e4;border-color:#e3cfca;color:#9a6b62;position:relative;padding:10px 0}
  .slot.off .t{font-size:14px;color:#b09a92;text-decoration:line-through;text-decoration-color:#c89a90}
  .slot.off .booked{display:block;font-size:11px;letter-spacing:.12em;color:#9c4a3f;margin-top:3px;font-family:"Noto Sans TC",sans-serif}
  .slot.off .booked::before{content:"";display:inline-block;width:5px;height:5px;border-radius:50%;background:#a8453a;margin-right:5px;vertical-align:middle}

  /* 大項目卡（點開選細項）*/
  .pickcard{display:flex;align-items:stretch;gap:12px;background:transparent;border:none;border-radius:0;
    padding:0;margin-bottom:34px;cursor:pointer;position:static;transition:transform .18s ease}
  .pickcard::after{display:none}
  .pickcard:active{transform:scale(.99)}
  .pickcard .info{flex:1;min-width:0;border:1px solid var(--brand);border-radius:18px;padding:16px 96px 16px 18px;
    background:#fff;display:flex;flex-direction:column;justify-content:center;position:relative}
  .pickcard.sel .info{background:var(--brand-soft);border-width:2px}
  /* 右邊「選擇 ›」按鈕：讓客人知道要點；選好變深色「✓ 已選」*/
  .pk-go{position:absolute;right:14px;top:50%;transform:translateY(-50%);font-size:13px;font-weight:700;
    color:var(--brand-deep);background:var(--brand-soft);border:1px solid var(--brand);padding:7px 13px;
    border-radius:16px;white-space:nowrap;letter-spacing:.04em}
  .pickcard.sel .pk-go{background:var(--brand);color:#fff;border-color:var(--brand)}
  .pk-from{font-size:13px;font-weight:600;color:var(--brand-deep);margin-top:8px}
  .pickcard .nm{font-size:17px;font-weight:700;color:var(--ink);letter-spacing:.03em;line-height:1.5}
  .pickcard .mt{font-size:12.5px;color:var(--grey);margin-top:4px;line-height:1.65}
  .pickcard .picked{display:inline-block;margin-top:8px;font-size:12px;font-weight:600;color:var(--brand);
    background:var(--brand-soft);border-radius:5px;padding:3px 9px}
  .pkright{display:none}
  .sec-title{font-family:"Noto Serif TC",serif;font-size:15px;font-weight:600;color:var(--taupe-deep);
    letter-spacing:.12em;margin:4px 4px 14px}
  /* 群組小標（質感霧眉 / 蜜感霧唇）*/
  .grp-title{font-family:"Noto Serif TC",serif;font-size:15px;font-weight:700;color:var(--taupe-deep);
    letter-spacing:.14em;margin:16px 2px 12px;padding-left:12px;position:relative}
  .grp-title:first-child{margin-top:2px}
  .grp-title::before{content:"";position:absolute;left:0;top:50%;transform:translateY(-50%);
    width:3px;height:15px;border-radius:2px;background:linear-gradient(180deg,#c9a961,#a8823f)}
  /* 贈送免費補色：柔金標籤，讓客人覺得賺到 */
  .gift-line{display:flex;align-items:center;gap:8px;margin-top:9px;font-size:12.5px;
    color:#7c3a45;background:#f7eef0;border:1px solid #e6ccd2;
    border-radius:10px;padding:7px 11px;font-weight:600;line-height:1.4}
  .gift-free{font-size:10.5px;font-weight:700;letter-spacing:.1em;color:#fff;
    background:#7c3a45;padding:2px 9px;border-radius:5px;white-space:nowrap}
  /* 服務卡片：縮圖 + 名稱說明 + 價格 */
  .svc{border:none;background:transparent;border-radius:0;padding:0;margin-bottom:34px;cursor:pointer;
    display:flex;align-items:stretch;gap:12px;transition:transform .18s ease}
  .svc:active{transform:scale(.99)}
  .svc .info{flex:1;min-width:0;border:1px solid var(--brand);border-radius:18px;padding:16px 18px;
    background:#fff;display:flex;flex-direction:column;justify-content:center;transition:.2s}
  .svc.sel .info{background:var(--brand-soft);border-width:2px}
  .svc .box{display:none}
  .svc .nm{font-weight:700;font-size:17px;color:var(--ink);letter-spacing:.03em;line-height:1.5}
  .svc .mt{font-size:12.5px;color:var(--grey);line-height:1.65;margin-top:4px}
  .more-link{display:block;text-align:center;margin:6px 0 10px;padding:14px;border:1px solid var(--divider);
    border-radius:18px;color:var(--brand);font-size:13.5px;letter-spacing:.04em;text-decoration:none;background:#fff}
  .more-link:active{background:var(--brand-soft)}
  /* 細項對話框：整齊清單 */
  .vgroup{font-size:13px;font-weight:700;color:var(--brand-deep);letter-spacing:.14em;
    margin:20px 2px 10px;padding-bottom:8px;border-bottom:1px solid var(--divider)}
  .vgroup:first-child{margin-top:2px}
  .vrow{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 14px;margin-bottom:8px;
    background:#fff;border:1.5px solid var(--divider);border-radius:14px;cursor:pointer;transition:.16s}
  .vrow:active{transform:scale(.99)}
  .vrow.sel{border-color:var(--brand);box-shadow:0 2px 10px rgba(140,124,106,.18)}
  .vrow.sel .v-nm{color:var(--brand-deep)}
  /* 勾選圈：複選是圓角方框、擇一是圓形；選中變實心打勾 */
  .v-check{flex-shrink:0;width:24px;height:24px;border-radius:7px;border:1.5px solid #cdbfae;background:#fff;
    display:grid;place-items:center;font-size:14px;font-weight:700;color:#fff;transition:.16s}
  .v-check.radio{border-radius:50%}
  .vrow.sel .v-check{background:var(--brand);border-color:var(--brand)}
  .v-sum{text-align:center;font-size:13.5px;font-weight:600;color:var(--brand-deep);background:#ece1d0;
    border-radius:12px;padding:10px;margin-top:10px}
  .v-left{flex:1;min-width:0}
  .v-nm{font-size:14.5px;font-weight:600;color:var(--ink);line-height:1.5}
  .v-sub{font-size:12px;color:var(--muted);margin-top:3px;line-height:1.5}
  .v-pr{font-size:15px;font-weight:700;color:var(--ink);white-space:nowrap}
  .v-pr.gift{color:#7c3a45;font-size:13.5px}
  /* 內嵌加購區 */
  .addonbox{margin:-22px 0 34px;border:1px solid #ddd0bd;border-radius:16px;overflow:hidden;
    background:linear-gradient(180deg,#f7f0e4,#f3ece2)}
  .addon-head2{display:flex;align-items:center;justify-content:space-between;padding:15px 18px;cursor:pointer;
    font-size:14px;font-weight:700;color:var(--brand-deep);letter-spacing:.08em}
  .addon-head2::before{content:"＋";margin-right:6px;color:var(--brand);font-weight:700}
  .ab-arrow{font-size:10px;color:var(--brand);transition:.25s}
  .addonbox.open .ab-arrow{transform:rotate(180deg)}
  .addon-list2{display:none;padding:0 12px 12px}
  .addonbox.open .addon-list2{display:block}
  .addrow{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:13px 14px;
    border:1px solid #e3d7c4;border-radius:12px;margin-bottom:8px;cursor:pointer;background:#fff;
    transition:.18s}
  .addrow:last-child{margin-bottom:0}
  .addrow.sel{border-color:var(--brand);background:var(--brand);color:#fff}
  .addrow.sel .ar-nm,.addrow.sel .ar-pr{color:#fff}
  .addrow.none .ar-nm{color:var(--muted)}
  .addrow.none.sel .ar-nm{color:#fff}
  .ar-nm{font-size:14px;color:var(--ink);font-weight:500}
  .ar-note{font-size:11.5px;color:var(--muted);font-weight:400;margin-left:7px}
  .addrow.sel .ar-note{color:rgba(255,255,255,.8)}
  .ar-pr{font-size:14px;font-weight:700;color:var(--ink);white-space:nowrap}
  /* 服務項目：左圖右卡 */
  .sym{display:none}
  .meta{display:flex;align-items:center;gap:18px;margin-top:10px;flex-wrap:wrap}
  .dur,.prices{display:flex;align-items:center;gap:5px;font-size:14px;font-weight:700;color:var(--ink)}
  .prices{margin-left:0}
  .p-was{font-size:13px;color:var(--grey);text-decoration:line-through;font-weight:400}
  .p-now{font-size:15px;font-weight:700;color:var(--ink);font-family:inherit}
  .p-now.free{font-size:13px;color:#7c3a45;font-weight:700}
  /* 勾選框：細緻圓角、選取時填入品牌棕 */
  .svc .box{width:22px;height:22px;border-radius:8px;border:1.5px solid var(--line);flex-shrink:0;
    display:grid;place-items:center;font-size:13px;color:transparent;background:#fff;transition:.18s}
  .svc.sel .box{background:var(--taupe);border-color:var(--taupe);color:#fff}
  /* 中間文字 */
  .svc .info{flex:1;min-width:0}
  .svc .nm{font-weight:500;font-size:15.5px;color:var(--ink);line-height:1.6;letter-spacing:.08em}
  .svc .mt{font-size:12.5px;color:var(--muted);line-height:1.6;margin-top:3px}
  .svc .sub-nm{font-size:13px;color:var(--taupe-deep);margin-top:2px;font-weight:500}
  .ppl-pick{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:4px}
  .ppl{border:1.5px solid var(--line);background:var(--cream-soft);border-radius:13px;padding:12px 4px;
    text-align:center;cursor:pointer;font-weight:600;font-size:14.5px;color:var(--ink);transition:.18s}
  .ppl:hover{border-color:var(--taupe)}
  .ppl.sel{background:var(--taupe);border-color:var(--taupe);color:var(--cream-soft)}
  .ppl-note{font-size:12px;color:var(--warn);margin:6px 2px 0;line-height:1.5}
  /* 加購彈窗維持勾選框樣式（沒有縮圖）*/
  .svc.addon .box{display:grid;width:22px;height:22px;border-radius:7px;border:1.5px solid var(--line);
    flex-shrink:0;place-items:center;font-size:14px;color:#fff;transition:.18s}
  .svc.addon.sel .box{background:var(--taupe);border-color:var(--taupe)}
  .svc .sub-nm{font-size:13px;color:var(--taupe-deep);margin-top:2px;font-weight:500}
  .new-badge{display:inline-block;margin-left:7px;font-size:9.5px;font-weight:700;letter-spacing:.08em;
    color:#fff;background:linear-gradient(135deg,#c9a961,#a8823f);padding:2px 7px;border-radius:20px;
    vertical-align:middle;transform:translateY(-1px);box-shadow:0 1px 3px rgba(168,130,63,.35)}
  .brow-info{margin-top:6px}
  .bi-block{background:#faf5ec;border:1px solid #ecdfc9;border-radius:14px;padding:14px 16px;margin-bottom:10px}
  .bi-block.bi-warn{background:#f7efe6;border-color:#e6cdba}
  .bi-h{font-family:"Noto Serif TC",serif;font-size:14px;font-weight:700;color:#8a6d3f;margin-bottom:8px}
  .bi-block p{font-size:12.5px;color:var(--ink);line-height:1.85;margin:4px 0}
  .bi-block b{color:#a8823f}
  .svc.combo .sub-nm{color:#9a7b4a}
  .svc.vip .sub-nm{color:#8a6c33;font-weight:600}
  /* 新客免費補色 */
  .svc.free .info{border-color:#c99aa4}
  .svc.free.sel .info{background:#f7eef0;border-color:#7c3a45}
  .svc.free .nm{color:var(--ink)}
  .svc.free .sub-nm{color:#7a8c5a}
  .svc.free .free-pr{color:#7c3a45;font-weight:700;font-size:13px;white-space:nowrap}
  .svc .pr{font-family:"Noto Serif TC",serif;font-size:15px;color:var(--taupe-deep);font-weight:700;
    white-space:nowrap;flex-shrink:0;text-align:right;letter-spacing:.02em}
  /* 分類 */
  /* 分類：純文字＋分隔線，無外框無陰影 */
  .cat{background:transparent;border:none;border-radius:0;margin:0;position:static;box-shadow:none}
  .cat::after{display:none}
  .cat-head{display:flex;align-items:center;gap:10px;padding:22px 0 18px;cursor:pointer;background:transparent;
    border-bottom:1px solid var(--divider)}
  .cat-rule{display:none}
  .cat-title{font-size:16px;font-weight:600;color:var(--ink);letter-spacing:.04em;flex:1;line-height:1.6}
  .cat-en{font-size:16px;font-weight:600;color:var(--ink);letter-spacing:.04em;font-family:inherit;font-style:normal}
  .cat-arrow{color:var(--ink);font-size:11px;flex-shrink:0;transform:none!important}
  .cat-head.locked{cursor:not-allowed}
  .cat-head.locked .cat-title,.cat-head.locked .cat-en{color:var(--grey)}
  .cat-locked-wrap{display:flex;align-items:baseline;gap:10px;flex:1;flex-wrap:wrap}
  .cat-lock{display:inline-block;font-size:11px;letter-spacing:.08em;color:var(--brand);
    background:var(--brand-soft);padding:2px 9px;border-radius:4px}
  .cat-body{display:none;padding:26px 0 8px}
  .cat.open .cat-body{display:block}
  .cat-body .svc{margin-bottom:10px}
  .cat-body .svc:last-child{margin-bottom:2px}
  /* 加購區 */
  .addon-sub{text-align:center;font-size:13px;color:var(--muted);margin-bottom:14px}
  .addon-total{text-align:center;font-size:13.5px;color:var(--taupe-deep);font-weight:600;background:#ece1d0;border-radius:12px;padding:11px;margin:14px 0 4px}
  .addon-skip{display:block;width:100%;margin-top:10px;padding:13px;border:1px solid var(--line);border-radius:14px;background:none;color:var(--muted);font:inherit;font-size:14px;cursor:pointer}
  .addon-skip:hover{border-color:var(--taupe);color:var(--taupe-deep)}
  #addonModal .modal-body{margin-bottom:4px}
  #addonModal .svc{margin-bottom:10px}
  .svc.addon{background:#fbf6ee}
  .svc.combo{background:#f7efe0;border-color:#dcc9a4}
  .svc.combo.sel{background:#eddcbd;border-color:#c9ab77}
