  input::placeholder,textarea::placeholder{color:#c2b5a2}

  .notice{background:var(--cream-soft);border:1px solid var(--line);border-radius:18px;padding:18px;font-size:14px;line-height:1.95;max-height:42vh;overflow-y:auto}
  .modal-mask{position:fixed;inset:0;z-index:50;background:rgba(74,64,56,.45);backdrop-filter:blur(3px);
    display:flex;align-items:center;justify-content:center;padding:20px}
  .modal-card{background:var(--cream);border-radius:22px;max-width:420px;width:100%;max-height:86vh;
